                </physical>
                <visual>
                    <mesh filename="iris/shell_foam_left.obj" scale="1.0"/>
                    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
                </visual>
                <material name="Foam"/>
                <mass value="2.260"/>
                <look name="gray"/>
                <compound_transform rpy="0.0 0.0 3.14159" xyz="0.0 0.0 0.0"/>
            </internal_part>
