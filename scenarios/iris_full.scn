            <internal_part name="travessa_b" type="model" always_visible="true" physics="submerged" buoyant="false">
                <physical>
                    <mesh filename="iris/travessa_b.obj" scale="1.0"/>
                    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
                </physical>
                <visual>
                    <mesh filename="iris/travessa_b.obj" scale="1.0"/>
                    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
                </visual>
                <material name="Plastic"/>
                <mass value="0.099"/>
                <look name="black"/>
                <compound_transform rpy="0.0 0.0 3.14159" xyz="0.0 0.0 0.0"/>
            </internal_part>
            <internal_part name="travessa_d" type="model" always_visible="true" physics="submerged" buoyant="false">
                <physical>
                    <mesh filename="iris/travessa_d.obj" scale="1.0"/>
                    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
                </physical>
                <visual>
                    <mesh filename="iris/travessa_d.obj" scale="1.0"/>
                    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
                </visual>
                <material name="Plastic"/>
                <mass value="0.102"/>
                <look name="black"/>
                <compound_transform rpy="0.0 0.0 3.14159" xyz="0.0 0.0 0.0"/>
            </internal_part>
             <!-- Single hydrodynamic body: drag and added mass are computed once for the whole vehicle
                 (with every mesh as an external part they were counted many times over, ~400 kg effective). -->
            <external_part name="hull" type="box" physics="submerged" buoyant="false">
                <!-- Stonefish computes drag/added mass per external part. A box at 0.51 x the mesh
                     bounding box (0.84 x 0.49 x 0.35 m) gives ~30 kg added mass (full size gave ~220 kg).
                     Drag scales with area, so Cd = physical Cd (0.8 surge, 1.0 sway, 1.2 heave) / 0.51^2. -->
                <dimensions xyz="0.428 0.250 0.178"/>
                <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
                <material name="Neutral"/>
                <mass value="0.01"/>
                <hydrodynamics quadratic_drag="3.08 3.84 4.61" viscous_drag="0.308 0.384 0.461"/>
                <look name="black"/>
                <compound_transform rpy="0.0 0.0 0.0" xyz="-0.069 0.0 0.0"/>
            </external_part>
            <!-- Buoyancy: two floats matching the foam shells (length, centroid y/z), 10.1 L each = 20.2 L
                 (1% positive for 20 kg). Centred at the CG in x (-0.032) so the vehicle trims level. -->
             <internal_part name="foam" type="cylinder" physics="submerged" buoyant="true">
				<dimensions radius="0.0709" height="0.64"/>
				<origin rpy="0.0 1.571 0.0" xyz="-0.032 0.126 -0.060"/>
				<material name="Foam"/>
				<mass value="0.02"/>
				<look name="manipulator"/>
				<compound_transform rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
			</internal_part>
            <internal_part name="foam2" type="cylinder" physics="submerged" buoyant="true">
				<dimensions radius="0.0709" height="0.64"/>
				<origin rpy="0.0 1.571 0.0" xyz="-0.032 -0.126 -0.060"/>
				<material name="Foam"/>
				<mass value="0.02"/>
				<look name="manipulator"/>
				<compound_transform rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
			</internal_part>
            <!-- <mass value="8.0"/> -->
            <inertia xyz="1.0 0.5 0.2"/>
            <cg xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </base_link>

        <sensor name="dynamics" type="odometry" rate="30.0">
			<link name="Vehicle"/>
			<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
			<ros_publisher topic="/iris/dynamics/odometry"/>
		</sensor>

		<sensor name="pressure" type="pressure" rate="5.0">
			<link name="Vehicle"/>
			<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
			<noise pressure="5.0"/>
			<ros_publisher topic="/iris/navigator/pressure"/>
		</sensor>

		<sensor name="dvl" type="dvl" rate="5.0">
			<link name="Vehicle"/>
			<origin rpy="3.1416 0.0 -0.785" xyz="0.0 0.0 0.2"/>
			<specs beam_angle="30.0"/>
			<range velocity="2.6 2.6 2.6" altitude_min="0.5" altitude_max="50.0"/>
			<noise velocity="0.0015" altitude="0.001"/>
			<ros_publisher topic="/iris/navigator/dvl" altitude_topic="/iris/navigator/altitude"/>
		</sensor>

		<sensor name="imu_filter" type="imu" rate="20.0">
			<link name="Vehicle"/>
			<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
			<noise angle="0.000001745" angular_velocity="0.00001745"/>
			<ros_publisher topic="/iris/navigator/imu"/>
		</sensor>

		<sensor name="gps" type="gps" rate="1.0">
			<link name="Vehicle"/>
			<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
			<noise ned_position="0.5"/>
			<ros_publisher topic="/iris/navigator/gps"/>
		</sensor>

		<sensor name="proscilica_back" type="camera" rate="10.0">
			<link name="Vehicle"/>
