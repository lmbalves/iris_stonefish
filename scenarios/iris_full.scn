<?xml version="1.0"?>
<scenario>
    <robot name="iris" fixed="false" self_collisions="false">
        <!-- Body frame is NED: +x bow, +y starboard, +z down. The meshes in data/iris are
             authored with the bow at -x, so every mesh part carries a yaw of pi in its
             compound_transform. Primitive parts (hull box, foam floats), sensor and actuator
             origins below are given directly in the bow=+x frame.
             Thruster positions/axes must match thrust_setpoints_pub.cpp in iris_control. -->

        <base_link name="Vehicle" type="compound" physics="submerged">

            <internal_part name="foam_right" type="model" always_visible="true" physics="submerged" buoyant="false">
                <physical>
                    <mesh filename="iris/shell_foam_right.obj" scale="1.0"/>
                    <!-- <thickness value="0.03"/> -->
                    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
                </physical>
                <visual>
                    <mesh filename="iris/shell_foam_right.obj" scale="1.0"/>
                    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
                </visual>
                <material name="Foam"/>
                <mass value="2.259"/>
                <look name="gray"/>
                <compound_transform rpy="0.0 0.0 3.14159" xyz="0.0 0.0 0.0"/>
            </internal_part>
            <internal_part name="foam_left" type="model" always_visible="true" physics="submerged" buoyant="false">
                <physical>
                    <mesh filename="iris/shell_foam_left.obj" scale="1.0"/>
                    <!-- <thickness value="0.03"/> -->
