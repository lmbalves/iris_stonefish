<?xml version="1.0"?>
<scenario>
    <robot name="iris" fixed="false" self_collisions="false">
        <base_link name="Vehicle" type="compound" physics="submerged">
        <mass value="20.0"/>
            
            <!-- Essential base structure  -->
            <external_part name="foam_right" type="model" physics="submerged" buoyant="false">
                <physical>
                    <mesh filename="iris/shell_foam_right.obj" scale="1.0"/>
                    <thickness value="0.03"/>
                    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
                </physical>
                <visual>
                    <mesh filename="iris/shell_foam_right.obj" scale="1.0"/>
                    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
                </visual>
                <material name="Foam"/>
                <look name="gray"/>
                <compound_transform rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
            </external_part>
            <external_part name="foam_right" type="model" physics="submerged" buoyant="false">
                <physical>
                    <mesh filename="iris/shell_foam_left.obj" scale="1.0"/>
                    <thickness value="0.03"/>
                    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
                </physical>
                <visual>
                    <mesh filename="iris/shell_foam_left.obj" scale="1.0"/>
                    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
                </visual>
                <material name="Foam"/>
                <look name="gray"/>
                <compound_transform rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
            </external_part>
            <!-- Essential buoyancy control -->
            <!-- <internal_part name="foam" type="cylinder" physics="submerged" buoyant="true">
                <dimensions radius="0.066" height="0.5"/>
                <origin rpy="0.0 1.571 0.0" xyz="0.0 -0.15 -0.05"/>
                <material name="Neutral"/>
                <mass value="2.72"/>
                <look name="manipulator"/>
                <compound_transform rpy="0.0 0.0 0.0" xyz="0.05 0.0 0.0"/>
            </internal_part> -->
        </base_link>

        <!-- Initial position -->
        <world_transform rpy="0.0 0.0 3.14159" xyz="-8.0 -8.0 1.0"/>
        
        <!-- ROS interface -->
        <ros_subscriber thrusters="/iris/controller/thruster_setpoints"/>
        <ros_publisher thrusters="/iris/controller/thruster_state"/>
    </robot>
</scenario>